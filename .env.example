# Copy this to .env and fill in your own values, or just run ./setup.sh.
# Every value here is optional -- sensible defaults apply if a line is missing.

# LAN CIDR(s) allowed to use the proxy, space-separated if more than one.
# Editable later from the dashboard's Settings page without restarting.
#
# NOTE: this check only works when the proxy sees real client IPs, i.e. with
# host networking on Linux. Under Docker Desktop (Windows/Mac) or plain bridge
# networking the proxy sees an internal gateway address instead, and this would
# reject every request. In that case leave it blank (here or in the dashboard)
# to disable the check -- see docs/security/overview.md for what's left
# gating Squid access once this is off.
LOCAL_NETWORK=192.168.1.0/24

# Dashboard admin login. Only read on first run to seed the account; editable
# from Settings afterwards. If DASHBOARD_PASSWORD is left blank, a random one
# is generated on first start and printed to the dashboard container's logs
# (`docker compose logs dashboard`). Separate from the per-person usernames/
# passwords you create for household members under Users -- as of 2026-08-30
# those aren't checked by anything (Squid now resolves identity from the
# device itself, not a login; see RoadMap.md's Squid intercept-mode section).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# 127.0.0.1 = dashboard only reachable from this machine (use SSH
# port-forwarding for remote access). 0.0.0.0 = reachable from any device
# on your LAN.
DASHBOARD_BIND=127.0.0.1

# Optional: if set (e.g. http://192.168.1.50:8787), blocked bump-mode
# requests (Crunchyroll, or any other domain you've set to "bump" mode)
# redirect to a friendly explanation page instead of a bare connection
# error. Leave blank to skip this -- browsers will just show a generic
# error for blocked bump-mode sites. Note this only applies to bump-mode
# domains; splice-mode blocks never show a page (see README).
DASHBOARD_URL=
